      "rootfs-integration": 360,
      "firmware-integration": 360,
      "boot-smoke": 360,
      "runtime-health": 360,
      "reboot-validation": 360,
      "config-resolve": 90
    },
    "maxPackageConfigBytes": 131072,
    "coverage": {
      "defaultLimit": 32,
      "maxLimit": 128
    }
  },
  "translation": {
    "defaultDataBranch": "catalog-candidate",
    "batchSize": 500,
    "batchCount": 5,
    "totalItemLimit": 5000,
    "totalTimeBudgetSeconds": 3000,
    "charBudget": 400000,
    "publishMode": "each-batch",
    "diagnosticsDays": 60
  },
  "catalog": {
    "diagnosticsDays": 60,
    "cloneAttempts": 3
  }
}
