{
  "schema": 1,
  "probe": {
    "collaboratorMaxParallel": 3,
    "ownerDefaultParallel": 0,
    "maxMatrixJobs": 256,
    "planFetchConcurrency": 4,
    "normalizedEvidenceDays": 60,
    "fullLogDays": 30,
    "timeoutMinutes": 360,
    "preferredTargetPatterns": [
      "x86/64",
      "*"
    ],
    "bootTargetPatterns": [
      "x86/64"
    ],
    "bootTimeoutSeconds": 180,
    "controlTimeoutSeconds": 30,
    "runtimeObservationSeconds": 15,
    "modeTimeoutMinutes": {
