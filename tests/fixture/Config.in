mainmenu "OpenWrt Configuration"

menu "Target System"
config TARGET_x86
	bool "x86"
config TARGET_x86_64
	bool "x86_64"
	depends on TARGET_x86
config TARGET_x86_64_DEVICE_generic
	bool "Generic x86/64"
	depends on TARGET_x86_64
config TARGET_x86_64_DEVICE_q35
	bool "QEMU Q35"
	depends on TARGET_x86_64
config TARGET_mediatek
	bool "MediaTek ARM"
config TARGET_mediatek_filogic
	bool "Filogic 8x0 (MT798x)"
	depends on TARGET_mediatek
config TARGET_mediatek_filogic_DEVICE_demo
	bool "Demo Router"
	depends on TARGET_mediatek_filogic
endmenu

menu "Target Images"
config TARGET_IMAGES_GZIP
	bool "GZip images"
	default y
endmenu

menu "LuCI"
menuconfig PACKAGE_luci
	tristate "LuCI"

if PACKAGE_luci
menu "Applications"
menuconfig PACKAGE_luci-app-demo
	tristate "Demo LuCI app"
	depends on TARGET_x86
	select PACKAGE_luci-base
	help
	  if the application is enabled, this sentence remains help text.
	  menu, endmenu and source are ordinary words inside help.

if PACKAGE_luci-app-demo
config PACKAGE_luci-app-demo-extra
	bool "Demo LuCI app extra feature"
endif

config PACKAGE_luci-i18n-demo-zh-cn
	tristate
	depends on PACKAGE_luci-app-demo
endmenu
endif
endmenu

choice
	prompt "Root filesystem"
config TARGET_ROOTFS_SQUASHFS
	bool "SquashFS"
config TARGET_ROOTFS_EXT4FS
	bool "ext4"
endchoice
