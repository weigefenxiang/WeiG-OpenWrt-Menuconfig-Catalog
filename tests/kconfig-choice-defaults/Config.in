mainmenu "Choice and scalar convergence"

config ENABLE_OWNER
	bool "Enable owner"

config BACKEND_AVAILABLE
	bool "Enable preferred backend"
	default y

if ENABLE_OWNER
source "backend-alternative.in"

config BACKEND_LIBRARY
	bool

config OWNER_TEXT
	string "Owner text"
	default "enabled" if BACKEND_LIBRARY
	default "alternative"

config OWNER_COUNT
	int "Owner count"
	default 12

config OWNER_MASK
	hex "Owner mask"
	default 0x20

config TRANSIENT_TEXT
	string
	depends on !BACKEND_LIBRARY
	default "!"

choice
	prompt "Optional backend"
	optional
	default OPTIONAL_MEMBER

config OPTIONAL_MEMBER
	bool "Optional member"

endchoice
endif
